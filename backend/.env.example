# =============================================================
# BACKEND ENVIRONMENT VARIABLES — copy this file to ".env" and
# fill in YOUR real values. Never commit the real ".env" file.
# =============================================================

# ---- DATABASE (REQUIRED) -------------------------------------
# Local example:   postgresql://postgres:password@localhost:5432/portfolio_db
# Railway/Render/Neon give you a full connection string, e.g.:
#   postgresql://user:pass@host.region.render.com:5432/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/portfolio_db

# ---- CORS (REQUIRED) ------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
# Add your deployed Vercel URL once you have it, e.g.:
#   https://aryan-portfolio.vercel.app
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- CONTACT FORM EMAIL (OPTIONAL) -----------------------------
# Only needed if you wire up the /contact endpoint to actually send
# an email instead of just storing it in the DB.
# Get an API key at https://resend.com or https://sendgrid.com
EMAIL_API_KEY=your_email_provider_api_key_here
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com

# ---- GITHUB API (OPTIONAL — Phase 2) ---------------------------
# Only needed for live GitHub stats/repo pulls (Phase 2 feature).
# Create a token at https://github.com/settings/tokens (repo:read scope)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username_here

# ---- LEETCODE (OPTIONAL — Phase 2) ------------------------------
# LeetCode has no official public API; if you wire up a scraper/
# third-party API, put its base URL and key here.
LEETCODE_USERNAME=your_leetcode_username_here

# ---- ENVIRONMENT -------------------------------------------------
ENVIRONMENT=development
